# Copy to .env, then edit for your NAS. No spaces around =.
# Set these to the numeric UID/GID of a dedicated DSM account.
# 1000:1000 is only a placeholder, not a guaranteed Synology account.
PUID=1000
PGID=1000
DOWNLOAD_DIR=./downloads
MG_PORT=8787
# Optional: NAS LAN IP to bind only that interface, e.g. 192.168.1.20
BIND_ADDRESS=0.0.0.0
# Comma-separated hostnames, without scheme/port. Private IPs are accepted.
MG_ALLOWED_HOSTS=
# Set 1 only when using HTTPS for all access. HTTP login won't work with 1.
MG_SECURE_COOKIE=0
